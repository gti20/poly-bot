# ── Polymarket wallet credentials ──────────────────────────────────────────
# Your wallet's private key (hex, with or without 0x prefix)
POLYMARKET_PRIVATE_KEY=

# The wallet address that holds your USDC funds on Polygon
# For proxy / email wallets this differs from the signing key address
POLYMARKET_FUNDER=

# ── Grok API ────────────────────────────────────────────────────────────────
GROK_API_KEY=

# Which Grok model to use (run --list-grok-models to see options)
GROK_MODEL=grok-3-mini

# ── Risk controls ────────────────────────────────────────────────────────────
# Notional bankroll in USD used for sizing (ignored when USE_LIVE_BALANCE=true)
TRADER_BANKROLL_USD=100.0

# If true, fetches live USDC balance from Polymarket for sizing; fails closed
TRADER_USE_LIVE_BALANCE=false

# Hard cap on bankroll even if live balance is larger
TRADER_BANKROLL_CAP_USD=500.0

# Fraction of Kelly to bet (0.25 = quarter-Kelly, recommended)
TRADER_KELLY_MULTIPLIER=0.25

# Maximum Kelly fraction per trade (safety cap)
TRADER_KELLY_FRACTION_CAP=0.10

# Minimum edge required to place an order (e.g. 0.03 = 3 cents edge)
TRADER_MIN_EDGE=0.03

# Divergence band size for ranking (larger = liquidity matters more)
TRADER_DIVERGENCE_BAND_SIZE=0.05

# Max ratio of intended bet size to available liquidity
TRADER_MAX_BET_TO_LIQUIDITY_RATIO=0.10

# How many markets to score per run
TRADER_MAX_MARKETS=50

# Pool of markets fetched before filtering/scoring
TRADER_MARKET_POOL_SIZE=200

# Max new positions to open per run
TRADER_MAX_POSITIONS_PER_RUN=5

# Max exit orders per run
TRADER_MAX_EXITS_PER_RUN=10

# Whether to attempt closing losing positions
TRADER_ENABLE_EXITS=true

# Edge below which we close an existing position
TRADER_EXIT_EDGE_THRESHOLD=-0.02

# ── Safety ───────────────────────────────────────────────────────────────────
# Set to false ONLY when you're ready for live trading
TRADER_DRY_RUN=true
